# ============================================================
# Routinely 로컬 개발 환경 시크릿 템플릿
#
# 사용법: cp infra/.env.example infra/.env  →  값을 채운다
# ⚠️  .env 파일은 절대 Git에 커밋하지 마세요. (.gitignore 처리됨)
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────
# docker-compose.yml 의 POSTGRES_PASSWORD 로 사용된다.
# 서비스 application-local.yaml 의 기본값(localpassword)과 같아야 local 프로파일이 환경변수 없이 붙는다.
# Postgres 는 볼륨을 처음 만들 때만 이 값을 적용한다 — 바꾸려면 ALTER USER 하거나 볼륨을 새로 만든다.
DB_PASSWORD=localpassword

# ── 아래는 local 에서 비워 둔다 ───────────────────────────────
# 비우면 application-local.yaml · compose 의 기본값이 적용된다. prod 배포 때 채운다.

# ── DB 접속 (prod 전용) ───────────────────────────────────────
# challenge · user · routine 의 application-prod.yaml 이 기본값 없이 읽는다 — 설정하지 않으면 기동 시점에 실패한다.
# prod 배포 때 주석을 풀고 채운다. 빈 값(KEY=)으로 두면 기본값이 아니라 빈 문자열이 들어간다 —
# 셸로 export 한 채 local 로 띄우면 application-local.yaml 의 기본값(localhost 등)이 적용되지 않는다.
# DB_PORT 는 줄 자체가 없으면 5432 가 적용된다.
# DB_HOST=
# DB_PORT=
# DB_USERNAME=

# ── JWT ───────────────────────────────────────────────────────
# Gateway 에서 JWT 서명 검증에 사용한다 (ADR-0006).
# 생성 예: openssl rand -base64 32
JWT_SECRET=

# ── Gateway 내부 통신 시크릿 ──────────────────────────────────
# X-Gateway-Secret 헤더 값. 내부 서비스가 직접 호출 여부 검증에 사용 (ADR-0019).
# gateway · challenge · user · routine 의 prod 프로파일은 기본값 없이 읽는다.
# 생성 예: openssl rand -hex 32
GATEWAY_SECRET=

# ── Grafana 관리자 비밀번호 ───────────────────────────────────
# 설정하지 않으면 기본값 'admin' 이 적용된다.
GRAFANA_PASSWORD=

# ── Gateway Rate Limiting (gateway-service 전용) ──────────────
# 생략 시 기본값 적용. RATE_LIMIT_TRUSTED_PROXIES는 prod 배포 시 Nginx IP를 설정한다.
RATE_LIMIT_CAPACITY=
RATE_LIMIT_REFILL_PERIOD_SECONDS=
RATE_LIMIT_TRUSTED_PROXIES=
RATE_LIMIT_FAIL_OPEN_ON_REDIS_ERROR=

# ── Eureka 주소 (prod 전용) ───────────────────────────────────
# registry-service: prod 프로파일에서 eureka.instance.hostname 으로 사용된다.
# gateway · challenge · user · routine: prod 프로파일의 Eureka 접속 주소(http://${EUREKA_HOST}:8761/eureka/)로 사용된다.
# 생략하면 registry-service 가 적용된다. 로컬(local 프로파일)에서는 localhost 로 고정되므로 설정 불필요.
EUREKA_HOST=
